{
    "compilerOptions": {
        "target": "ES2020",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2020", "DOM"],
        "strict": true,
        "sourceMap": true,
        "noEmitOnError": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "dist",
        "rootDir": "."
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules"]
}
